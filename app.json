{
  "expo": {
    "name": "Pozzy",
    "slug": "pozzy",
    "version": "1.0.7",
    "scheme": "pozzy",
    "orientation": "portrait",
    "icon": "./assets/icons/store/app-store-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pozzy.mobile"
    },
    "android": {
      "package": "com.pozzy.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A4A42",
        "foregroundImage": "./assets/icons/android/adaptive-png/foreground.png",
        "backgroundImage": "./assets/icons/android/adaptive-png/background.png",
        "monochromeImage": "./assets/icons/android/adaptive-png/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-asset",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешить Pozzy использовать микрофон для голосового ввода.",
          "speechRecognitionPermission": "Разрешить Pozzy распознавать речь для голосового ввода."
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-calendar",
        {
          "calendarPermission": "Разрешить Pozzy добавлять напоминания в календарь."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ],
      "expo-quick-actions"
    ]
  }
}
